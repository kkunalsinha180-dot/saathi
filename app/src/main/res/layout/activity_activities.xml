<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back -->
        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="← Back"
            android:textSize="16sp"
            android:textColor="#334155"
            android:backgroundTint="#E2E8F0" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Activities"
            android:textColor="#1E293B"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Choose something you'd like to do"
            android:textColor="#64748B"
            android:textSize="17sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <!-- Memory -->
        <Button
            android:id="@+id/memoryActivity"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="🧠  Memory"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:backgroundTint="#DDEBFF"
            android:layout_marginBottom="18dp" />

        <!-- People -->
        <Button
            android:id="@+id/peopleActivity"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="👨‍👩‍👧  People"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:backgroundTint="#E6F7E9"
            android:layout_marginBottom="18dp" />

        <!-- Daily Routine -->
        <Button
            android:id="@+id/routineActivity"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="📅  Daily Routine"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:backgroundTint="#FFF1D6"
            android:layout_marginBottom="18dp" />

        <!-- Familiar Places -->
        <Button
            android:id="@+id/placesActivity"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="📍  Familiar Places"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:backgroundTint="#FDE2E4"
            android:layout_marginBottom="24dp" />

        <!-- Encouragement -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Take your time. There is no rush."
            android:textColor="#64748B"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>